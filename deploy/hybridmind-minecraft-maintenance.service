[Unit]
Description=Minecraft maintenance endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
ExecStart=/usr/bin/python3 /home/azureuser/hybridmind/deploy/minecraft_maintenance.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
