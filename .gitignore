# SQLite database (regenerated from .mind or API)
data/hybridmind.db
data/*.db

# Snapshots & backups (can be large; regenerate with POST /snapshot)
data/backups/

# ChromaDB comparison store
data/chromadb/
data/chromadb_benchmark/

